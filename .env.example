# Bot
BOT_TOKEN=your_telegram_bot_token
BOT_USERNAME=VeyloWalletBot
WEBHOOK_URL=
WEBHOOK_PORT=3000

# Admin
ADMIN_TELEGRAM_IDS=123456789,987654321
ADMIN_API_KEY=your-secure-admin-api-key

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/veylo

# Redis
REDIS_URL=redis://localhost:6379

# Blockchain - BNB Smart Chain
BSC_PRIMARY_RPC=https://bsc-mainnet.nodereal.io/v1/your-api-key
BSC_PUBLIC_RPCS=https://bsc-dataseed.binance.org/,https://bsc-dataseed1.defibit.io/,https://bsc-dataseed1.ninicoin.io/,https://bsc-dataseed2.binance.org/
BSC_CHAIN_ID=56

# Wallet
WALLET_ENCRYPTION_KEY=your-32-char-encryption-key-here!!
PLATFORM_FEE_WALLET=0xYourFeeWalletAddress

# Platform
PLATFORM_FEE_PERCENT=1.0
MINIMUM_AMOUNT_USD=0.1
ENABLE_FEES=true

# Rewards (central business rules — defaults; admins can tune at runtime)
REWARD_CREATOR_PERCENT=1.0
REWARD_REFERRAL_PERCENT=1.0

# Payout origin: 'creator' (default, legacy) or 'platform'
PAYOUT_ORIGIN=creator

# Deposit sessions
DEPOSIT_SESSION_TTL_MINUTES=30

# Pricing
PRICE_API_URL=https://api.coingecko.com/api/v3
NGN_RATE_API_URL=https://api.exchrangerate-api.com/v4/latest/USD

# Queue
QUEUE_CONCURRENCY=5
PAYOUT_RETRY_DELAY_MS=30000

# Features
ENABLE_DEPOSITS=true
ENABLE_GIVEAWAYS=true
ENABLE_PAYOUTS=true
MAINTENANCE_MODE=false
