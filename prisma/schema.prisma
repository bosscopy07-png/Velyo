generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(cuid())
  telegramId      String     @unique
  username        String?
  firstName       String?
  lastName        String?
  joinDate        DateTime   @default(now())
  lastActive      DateTime   @updatedAt
  mainMessageId   String?
  chatId          String?
  status          UserStatus @default(ACTIVE)
  isAdmin         Boolean    @default(false)

  wallet          Wallet?
  balances        Balance[]
  transactions    Transaction[]
  giveaways       Giveaway[]
  claims          GiveawayClaim[]
  codeRedemptions CodeRedemption[]
  auditLogs       AuditLog[]
  rewards         Reward[]
  attributionsAsClaimant GiveawayAttribution[] @relation("AttributionClaimant")
  attributionsAsCreator  GiveawayAttribution[] @relation("AttributionCreator")
  claimBlocksCreated     ClaimBlock[]          @relation("BlocksCreated")
  claimBlocksReceived    ClaimBlock[]          @relation("BlocksReceived")
  depositSessions        DepositSession[]

  @@index([telegramId])
  @@index([status])
  @@map("users")
}

model Wallet {
  id                  String       @id @default(cuid())
  userId              String       @unique
  user                User         @relation(fields: [userId], references: [id])
  address             String       @unique
  encryptedPrivateKey String
  encryptedMnemonic   String?
  status              WalletStatus @default(ACTIVE)
  createdAt           DateTime     @default(now())

  @@index([address])
  @@index([userId])
  @@map("wallets")
}

model Balance {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  asset            String
  availableBalance Decimal  @default(0) @db.Decimal(36, 18)
  lockedBalance    Decimal  @default(0) @db.Decimal(36, 18)
  pendingBalance   Decimal  @default(0) @db.Decimal(36, 18)
  updatedAt        DateTime @updatedAt

  @@unique([userId, asset])
  @@index([userId])
  @@index([asset])
  @@map("balances")
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  type            TransactionType
  asset           String
  amount          Decimal           @db.Decimal(36, 18)
  fee             Decimal           @default(0) @db.Decimal(36, 18)
  netAmount       Decimal           @db.Decimal(36, 18)
  status          TransactionStatus @default(PENDING)
  transactionHash String?
  fromAddress     String?
  toAddress       String?
  metadata        Json?
  idempotencyKey  String            @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  platformFee     PlatformFee?
  giveawayClaim   GiveawayClaim?    @relation("GiveawayPayoutTransaction")

  @@index([userId])
  @@index([status])
  @@index([transactionHash])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@map("transactions")
}

model Giveaway {
  id                 String         @id @default(cuid())
  creatorId          String
  creator            User           @relation(fields: [creatorId], references: [id])
  asset              String
  totalAmount        Decimal        @db.Decimal(36, 18)
  amountPerUser      Decimal        @db.Decimal(36, 18)
  maxClaimers        Int
  claimedCount       Int            @default(0)
  openedCount        Int            @default(0)
  attemptCount       Int            @default(0)
  status             GiveawayStatus @default(ACTIVE)
  secureCode         String         @unique
  expiresAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  cancelledAt        DateTime?
  cancellationReason String?

  claims        GiveawayClaim[]
  attributions  GiveawayAttribution[]
  claimBlocks   ClaimBlock[]

  @@index([creatorId])
  @@index([status])
  @@index([secureCode])
  @@index([expiresAt])
  @@map("giveaways")
}

model GiveawayClaim {
  id                    String       @id @default(cuid())
  giveawayId            String
  giveaway              Giveaway     @relation(fields: [giveawayId], references: [id])
  userId                String
  user                  User         @relation(fields: [userId], references: [id])
  status                ClaimStatus  @default(RESERVED)
  claimedAt             DateTime     @default(now())
  walletAddress         String?
  payoutTransactionId   String?      @unique
  payoutTransaction     Transaction? @relation("GiveawayPayoutTransaction", fields: [payoutTransactionId], references: [id])
  payoutTransactionHash String?
  failedReason          String?
  claimOrder            Int

  attribution GiveawayAttribution?
  flags       ClaimFlag[]

  @@unique([giveawayId, userId])
  @@index([giveawayId])
  @@index([userId])
  @@index([status])
  @@map("giveaway_claims")
}

model RedeemCode {
  id              String     @id @default(cuid())
  code            String     @unique
  asset           String
  rewardAmount    Decimal    @db.Decimal(36, 18)
  maxRedemptions  Int        @default(1)
  redemptionCount Int        @default(0)
  expiresAt       DateTime?
  status          CodeStatus @default(ACTIVE)
  createdBy       String
  createdAt       DateTime   @default(now())

  redemptions CodeRedemption[]

  @@index([code])
  @@index([status])
  @@map("redeem_codes")
}

model CodeRedemption {
  id         String   @id @default(cuid())
  codeId     String
  code       RedeemCode @relation(fields: [codeId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  redeemedAt DateTime @default(now())
  amount     Decimal  @db.Decimal(36, 18)

  @@unique([codeId, userId])
  @@index([codeId])
  @@index([userId])
  @@map("code_redemptions")
}

model PlatformFee {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  asset         String
  amount        Decimal     @db.Decimal(36, 18)
  feeWallet     String
  sweptAt       DateTime?
  createdAt     DateTime    @default(now())

  @@index([transactionId])
  @@map("platform_fees")
}

model DepositMonitor {
  id                    String        @id @default(cuid())
  address               String
  asset                 String
  txHash                String
  amount                Decimal       @db.Decimal(36, 18)
  confirmations         Int           @default(0)
  requiredConfirmations Int           @default(15)
  status                MonitorStatus @default(PENDING)
  processedAt           DateTime?
  createdAt             DateTime      @default(now())

  @@unique([txHash, address])
  @@index([address])
  @@index([status])
  @@map("deposit_monitors")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  adminId    String?
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("system_configs")
}

// ─────────────────────────────── UPGRADE: REWARDS & ATTRIBUTION ─────────────

model Reward {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  type           RewardType
  sourceType     String       // 'giveaway' (extensible: 'deposit', ...)
  sourceId       String       // giveaway id (or attribution id for referral)
  asset          String
  amount         Decimal      @db.Decimal(36, 18)
  status         RewardStatus @default(CREDITED)
  idempotencyKey String       @unique
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([sourceType, sourceId])
  @@map("rewards")
}

model GiveawayAttribution {
  id         String              @id @default(cuid())
  giveawayId String
  giveaway   Giveaway            @relation(fields: [giveawayId], references: [id])
  claimantId String
  claimant   User                @relation("AttributionClaimant", fields: [claimantId], references: [id])
  creatorId  String
  creator    User                @relation("AttributionCreator", fields: [creatorId], references: [id])
  claimId    String?             @unique
  claim      GiveawayClaim?      @relation(fields: [claimId], references: [id])
  source     AttributionSource
  status     AttributionStatus   @default(ACTIVE)
  createdAt  DateTime            @default(now())

  @@unique([giveawayId, claimantId])
  @@index([claimantId])
  @@index([creatorId])
  @@map("giveaway_attributions")
}

model ClaimBlock {
  id            String    @id @default(cuid())
  creatorId     String
  creator       User      @relation("BlocksCreated", fields: [creatorId], references: [id])
  blockedUserId String
  blockedUser   User      @relation("BlocksReceived", fields: [blockedUserId], references: [id])
  giveawayId    String?   // null = creator-scoped (all current & future giveaways)
  giveaway      Giveaway? @relation(fields: [giveawayId], references: [id])
  reason        String?
  createdAt     DateTime  @default(now())

  @@index([creatorId, blockedUserId])
  @@map("claim_blocks")
}

model ClaimFlag {
  id         String        @id @default(cuid())
  claimId    String
  claim      GiveawayClaim @relation(fields: [claimId], references: [id])
  giveawayId String
  signal     String        // 'SHARED_WALLET' | 'CROSS_ACCOUNT_WALLET' | 'CLAIM_VELOCITY'
  severity   FlagSeverity  @default(POSSIBLE_DUPLICATE)
  detail     Json?
  status     FlagStatus    @default(OPEN)
  createdAt  DateTime      @default(now())
  reviewedAt DateTime?
  reviewedBy String?

  @@index([giveawayId, status])
  @@index([claimId])
  @@map("claim_flags")
}

// ─────────────────────────────── UPGRADE: DEPOSIT SESSIONS ──────────────────

model CompanyDepositWallet {
  id                  String            @id @default(cuid())
  address             String            @unique
  encryptedPrivateKey String
  status              CompanyWalletStatus @default(ACTIVE)
  lastAssignedAt      DateTime?
  createdAt           DateTime          @default(now())

  sessions DepositSession[]

  @@map("company_deposit_wallets")
}

model DepositSession {
  id               String               @id @default(cuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id])
  asset            String
  requestedAmount  Decimal              @db.Decimal(36, 18)
  platformFee      Decimal              @default(0) @db.Decimal(36, 18)
  expectedAmount   Decimal              @db.Decimal(36, 18)
  uniqueSuffix     Decimal              @default(0) @db.Decimal(36, 18)
  assignedWalletId String
  assignedWallet   CompanyDepositWallet @relation(fields: [assignedWalletId], references: [id])
  paymentRef       String               @unique
  txHash           String?              @unique
  detectedTxHash   String?
  detectedAmount   Decimal?             @db.Decimal(36, 18)
  status           DepositSessionStatus @default(AWAITING)
  creditedAmount   Decimal?             @db.Decimal(36, 18)
  expiresAt        DateTime
  createdAt        DateTime             @default(now())
  creditedAt       DateTime?
  forwardedAt      DateTime?

  @@index([userId])
  @@index([status, expiresAt])
  @@map("deposit_sessions")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  FROZEN
  BANNED
}

enum WalletStatus {
  ACTIVE
  DISABLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  GIVEAWAY_CREATED
  GIVEAWAY_CANCELLED
  GIVEAWAY_REWARD
  CODE_REDEMPTION
  PLATFORM_FEE
  REFUND
  TRANSFER
  PAYOUT
  REWARD
}

enum TransactionStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
  CANCELLED
}

enum GiveawayStatus {
  DRAFT
  ACTIVE
  FULL
  EXPIRED
  CANCELLED
  PROCESSING
  COMPLETED
  FAILED
}

enum ClaimStatus {
  OPENED
  ATTEMPTED
  RESERVED
  ADDRESS_PENDING
  ADDRESS_CONFIRMED
  QUEUED
  PROCESSING
  PAID
  FAILED
  REJECTED
}

enum CodeStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  DEPLETED
}

enum MonitorStatus {
  PENDING
  CONFIRMING
  CONFIRMED
  PROCESSED
  FAILED
}

enum RewardType {
  GIVEAWAY_CASHBACK
  REFERRAL_REWARD
}

enum RewardStatus {
  PENDING
  CREDITED
  APPLIED
  FAILED
}

enum AttributionSource {
  GIVEAWAY_LINK
  MANUAL_CODE
}

enum AttributionStatus {
  ACTIVE
  REVOKED
}

enum FlagSeverity {
  POSSIBLE_DUPLICATE
  CONFIRMED_ABUSE
}

enum FlagStatus {
  OPEN
  DISMISSED
  CONFIRMED
}

enum CompanyWalletStatus {
  ACTIVE
  DISABLED
}

enum DepositSessionStatus {
  AWAITING
  DETECTED
  CREDITED
  EXPIRED
  FAILED
}

model Broadcast {
  id            String          @id @default(cuid())
  createdBy     String
  text          String          @db.Text
  entities      Json?
  status        BroadcastStatus @default(SENDING)
  expireMinutes Int
  targetCount   Int             @default(0)
  sentCount     Int             @default(0)
  failedCount   Int             @default(0)
  createdAt     DateTime        @default(now())
  finishedAt    DateTime?

  deliveries BroadcastDelivery[]

  @@index([createdAt])
  @@map("broadcasts")
}

model BroadcastDelivery {
  id          String    @id @default(cuid())
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id])
  telegramId  String
  chatId      String
  messageId   Int
  sentAt      DateTime  @default(now())
  openedAt    DateTime?
  deleteAt    DateTime
  deletedAt   DateTime?
  attempts    Int       @default(0)

  @@index([broadcastId])
  @@index([telegramId, openedAt, deletedAt])
  @@index([deletedAt, deleteAt])
  @@map("broadcast_deliveries")
}

enum BroadcastStatus {
  SENDING
  COMPLETED
  INTERRUPTED
  RECALLED
}
